<mvc:View controllerName="wui.sd.rocket2.controller.Customers"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
	<f:DynamicPage id="idCustomersPage" headerExpanded="{layoutModel>/customersPage/headerExpanded}"
		toggleHeaderOnTitleClick="{layoutModel>/customersPage/titleClickable}">
		<f:title><f:DynamicPageTitle><f:heading>
			<Title text="{parts: ['i18n>customersPageHeaderText', '/SelectedSalesRep/SalesRepName'], formatter: 'jQuery.sap.formatMessage'}"/>
		</f:heading></f:DynamicPageTitle></f:title>
		<f:content>
			<List id="customerList" items="{/CustomersSet}" noDataText="{i18n>customersListNoDataText}" class="sapUiSmallMargin">
				<CustomListItem>
					<VBox class="sapUiSmallMargin">
						<Title text="{CustomerName}" titleStyle="H4"/>
						<HBox class="sapUiTinyMarginTop">
							<core:Icon src="sap-icon://customer"/><Text class="sapUiTinyMarginBegin" text="{CustomerNo}"/>
							<Text class="sapUiSmallMarginBegin" text="{ZipCode}"/><Text class="sapUiTinyMarginBegin" text="{City}"/>
						</HBox>
						<form:SimpleForm editable="false" layout="ResponsiveGridLayout" class="sapUiTinyMarginTop">
							<Label text="{rocket2Online>/#Position/TurnoverCustomerAY/@sap:label}"/>
							<ObjectNumber number="{path:'TurnoverCustomerAY', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2,maxFractionDigits:2}}" unit="{Currency}"/>
							<Label text="{rocket2Online>/#Position/TurnoverCustomerPY/@sap:label}"/>
							<ObjectNumber number="{path:'TurnoverCustomerPY', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2,maxFractionDigits:2}}" unit="{Currency}"/>
							<Label text="{rocket2Online>/#Position/TurnoverConditionsAY/@sap:label}"/>
							<ObjectNumber number="{path:'TurnoverConditionsAY', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2,maxFractionDigits:2}}" unit="{Currency}"/>
							<Label text="{rocket2Online>/#Position/TurnoverDifferenceAY/@sap:label}"/>
							<ObjectNumber number="{path:'TurnoverDifferenceAY', type:'sap.ui.model.type.Float', formatOptions:{minFractionDigits:2,maxFractionDigits:2}}" unit="{Currency}"/>
							<Label text="{rocket2Online>/#Position/SelectedOption/@sap:label}"/><Text text="{SelectedOption}"/>
						</form:SimpleForm>
					</VBox>
				</CustomListItem>
			</List>
		</f:content>
	</f:DynamicPage>
</mvc:View>

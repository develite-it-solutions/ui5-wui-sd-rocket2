<mvc:View
	xmlns:mvc="sap.ui.core.mvc"
	controllerName="wui.sd.rocket2.controller.App"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:f="sap.f">

	<App
		id="app"
		busy="{appView>/busy}"
		busyIndicatorDelay="{appView>/delay}"/>

		<f:FlexibleColumnLayout id="flexibleColumnLayout">
			<f:beginColumnPages />
			<f:midColumnPages />
		</f:FlexibleColumnLayout>
</mvc:View>
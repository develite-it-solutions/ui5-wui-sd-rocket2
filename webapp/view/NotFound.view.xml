<mvc:View
	controllerName="wui.sd.rocket2.controller.NotFound"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m">

	<MessagePage
		title="{i18n>notFoundTitle}"
		text="{i18n>notFoundText}"
		icon="sap-icon://document"
		id="notfoundPage"
		description="">
		<customDescription>
			<Link
				id="link"
				text="{i18n>backToHome}"
				press=".onLinkPressed" />
		</customDescription>
	</MessagePage>

</mvc:View>
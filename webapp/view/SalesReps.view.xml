<mvc:View controllerName="wui.sd.rocket2.controller.SalesReps"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
	<f:DynamicPage id="idSalesRepsPage" headerExpanded="{layoutModel>/salesRepsPage/headerExpanded}"
		toggleHeaderOnTitleClick="{layoutModel>/salesRepsPage/titleClickable}">
		<f:title><f:DynamicPageTitle><f:heading><Title text="{i18n>salesRepsPageHeaderText}"/></f:heading></f:DynamicPageTitle></f:title>
		<f:content>
			<List id="salesRepList" items="{/SalesRepSet}" noDataText="{i18n>salesRepsListNoDataText}" class="sapUiSmallMargin">
				<CustomListItem type="Navigation" press="onPressSalesRep">
					<VBox class="sapUiSmallMargin">
						<Title text="{SalesRepName}" titleStyle="H4"/>
						<HBox class="sapUiTinyMarginTop">
							<core:Icon src="sap-icon://wui/wuerth-verkaeufer"/>
							<Text class="sapUiTinyMarginBegin" text="{parts: ['SalesRep'], formatter: '.formatter.removeLeadingZeroes'}"/>
							<core:Icon class="sapUiSmallMarginBegin" src="sap-icon://wui/building-office-b"/>
							<Text class="sapUiTinyMarginBegin" text="{SalesOrganization}"/>
						</HBox>
						<form:SimpleForm editable="false" layout="ResponsiveGridLayout">
							<Label text="{rocket2Online>/#Header/Manager/@sap:label}"/><Text text="{ManagerName} / {Manager}"/>
							<Label text="{rocket2Online>/#Header/AreaManager/@sap:label}"/><Text text="{AreaManagerName} / {AreaManager}"/>
							<Label text="{rocket2Online>/#Header/RegionalManager/@sap:label}"/><Text text="{RegionalManager}"/>
							<Label text="{rocket2Online>/#Header/CountOfCustomers/@sap:label}"/><Text text="{CountOfCustomers}"/>
							<Label text="{rocket2Online>/#Header/ValidOn/@sap:label}"/><Text text="{path:'ValidOn', type:'sap.ui.model.type.Date', formatOptions:{style:'medium'}}"/>
						</form:SimpleForm>
					</VBox>
				</CustomListItem>
			</List>
		</f:content>
	</f:DynamicPage>
</mvc:View>
